<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs every client method against a real Anvil environment and prints a
    pass or fail for each. See the file header in Program.cs.

      ANVIL_API_KEY=<your API key> dotnet run \-\-project test-client
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>TestClient</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../src/Anvil/Anvil.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="assets/dummy.pdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
