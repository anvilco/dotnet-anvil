<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Bumped by dev/release.sh; the Publish workflow checks the tag matches -->
        <Version>1.0.0-alpha.1</Version>

        <PackageId>Anvil</PackageId>
        <Authors>useanvil.com, Allan Almazan</Authors>
        <Company>useanvil.com</Company>
        <Description>.NET/C# API client for Anvil: PDF filling, PDF generation, Etch e-signatures and Workflows. https://www.useanvil.com/docs</Description>
        <PackageTags>PDF;Anvil;e-signature;esign;workflows;forms</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/anvilco/dotnet-anvil</PackageProjectUrl>
        <PackageReleaseNotes>https://github.com/anvilco/dotnet-anvil/blob/main/CHANGELOG.md</PackageReleaseNotes>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>images/icon.png</PackageIcon>
        <RepositoryUrl>https://github.com/anvilco/dotnet-anvil</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <RepositoryBranch>main</RepositoryBranch>

        <!-- XML docs ship in the package; the symbols package and Source Link make it debuggable -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <!-- CS1591: not every public member has docs; CS1573: options and cancellationToken are not documented on every method -->
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="AnvilTests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <None Include="../../README.md" Pack="true" PackagePath="/" />
        <None Include="../../images/icon.png" Pack="true" PackagePath="/images" />
    </ItemGroup>

</Project>
